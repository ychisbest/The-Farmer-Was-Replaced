---
import { type CollectionEntry, getCollection } from "astro:content";
import { render } from "astro:content";
import { DEFAULT_LOCALE_SETTING, LOCALES_SETTING } from "@/locales";
import Layout from "@/layouts/BaseLayout.astro";
import { getFileNameFromPath, getLangFromPath } from "@/common";
import { Image } from 'astro:assets';
import AdNative from "@/components/AdNative.astro";


export async function getStaticPaths() {
	const posts: CollectionEntry<"blog">[] = (await getCollection("blog"));
	const localeKeys = Object.keys(LOCALES_SETTING);

	const paths = posts.flatMap((post) => {
		const slug = getFileNameFromPath(post.filePath);
		const langFromPath = getLangFromPath(post.filePath);

		if (localeKeys.includes(langFromPath) && langFromPath !== DEFAULT_LOCALE_SETTING) {
			return [{
				params: { slug, lang: langFromPath },
				props: post,
			}];
		}

		return [{
			params: { slug },
			props: post,
		}];
	});

	return paths;
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

---

<Layout title={post.data.title} description={post.data.description}>
	<h1 class="text-2xl md:text-3xl font-bold text-center mb-4 text-gray-900 dark:text-white">{post.data.title}</h1>
	<AdNative />
	<article class="prose lg:prose-sm mx-auto dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">
		{post.data.image && (
			<Image src={post.data.image} alt={post.data.title} class="mx-auto mb-6 rounded max-h-64 w-auto" />
		)}
		<Content />
	</article>
</Layout>
