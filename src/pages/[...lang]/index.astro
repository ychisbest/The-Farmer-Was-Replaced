---
import { DEFAULT_LOCALE_SETTING, LOCALES_SETTING } from "@/locales";
import { useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import FAQ from "@/components/FAQ.astro";
import { Image } from "astro:assets";
import logo from "@/assets/geminiHero.png";

import CollapsibleText from "@/components/CollapsibleText.astro";
import AdNative from "@/components/AdNative.astro";
// --- Data Fetching Logic ---
const t = useTranslations(Astro.currentLocale as Lang);
const locale = Astro.currentLocale || DEFAULT_LOCALE_SETTING;

export const getStaticPaths = async () => {
    const paths = Object.keys(LOCALES_SETTING).map((lang) => {
        if (lang !== DEFAULT_LOCALE_SETTING) {
            return { params: { lang: lang } };
        } else {
            return { params: { lang: undefined } };
        }
    });
    return paths;
};

const title = {
    en: "Codes, Guide & Python Scripts",
    zh: "代码、攻略与 Python 脚本",
    de: "Codes, Guide und Skripte",
    ru: "Готовые коды, гайд и Python-скрипты",
};

const description = {
    en: "Copy-paste pumpkin, cactus, sunflower and maze codes for The Farmer Was Replaced. Steam desktop (Windows & macOS). DLC The Miner Was Replaced: Nov 2, 2026.",
    zh: "南瓜、仙人掌、向日葵、迷宫可复制代码。Steam 电脑游戏（Windows / macOS）。DLC《The Miner Was Replaced》2026-11-02。",
    de: "Kürbis-, Kaktus-, Sonnenblumen- und Labyrinth-Codes. Steam-PC (Windows & macOS). DLC The Miner Was Replaced: 2.11.2026.",
    ru: "Готовые коды тыквы, кактуса, подсолнуха и лабиринта для The Farmer Was Replaced. Steam (Windows и macOS). DLC The Miner Was Replaced: 2 ноября 2026.",
};
---

<Layout title={title} description={description}>
    <section
        class="relative pt-20 pb-24 px-4  border-b border-gray-100 dark:border-gray-800"
    >
        <div
            class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-16"
        >
            <div class="flex-1 text-center md:text-left space-y-8">
                <h1
                    class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-none"
                >
                    {
                        t({
                            zh: "编程农场代码与攻略",
                            en: "The Farmer Was Replaced Codes",
                            de: "The Farmer Was Replaced Codes",
                            ru: "The Farmer Was Replaced — готовые коды",
                        })
                    }
                    <span class="text-green-600 block mt-4">
                        {
                            t({
                                zh: "南瓜、仙人掌、向日葵与迷宫脚本",
                                en: "Pumpkin, cactus, sunflower & maze scripts",
                                de: "Kürbis-, Kaktus-, Sonnenblumen- und Labyrinth-Skripte",
                                ru: "Скрипты: тыква, кактус, подсолнух и лабиринт",
                            })
                        }
                    </span>
                </h1>
                <p
                    class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto md:mx-0 leading-relaxed"
                >
                    <span set:html={t({
                            zh: `在这里复制《编程农场》南瓜、仙人掌、向日葵和迷宫脚本。Steam 电脑游戏（Windows / macOS 原生；Linux / Deck 走 Proton），没有<a class="text-green-700 dark:text-green-400 underline" href="${getRelativeLocaleUrl(locale, "/blog/mobile-android-online")}">网页版和手机版</a>。DLC《The Miner Was Replaced》将于 2026-11-02 发售。`,
                            en: `Copy-paste The Farmer Was Replaced codes for pumpkin, cactus, sunflower and maze. Steam desktop (Windows & macOS native; Linux/Deck via Proton) — not <a class="text-green-700 dark:text-green-400 underline" href="${getRelativeLocaleUrl(locale, "/blog/mobile-android-online")}">online or mobile</a>. DLC The Miner Was Replaced launches November 2, 2026.`,
                            de: `The Farmer Was Replaced Codes: Kürbis, Kaktus, Sonnenblume, Labyrinth. Steam-PC (Windows & macOS nativ; Linux/Deck via Proton) — nicht <a class="text-green-700 dark:text-green-400 underline" href="${getRelativeLocaleUrl(locale, "/blog/mobile-android-online")}">online oder mobil</a>. DLC The Miner Was Replaced erscheint am 2.11.2026.`,
                            ru: `Копипаст The Farmer Was Replaced коды для тыквы, кактуса, подсолнечника и лабиринта. Настольный компьютер Steam (родной для Windows и macOS; Linux/Deck через Proton) — не <a class="text-green-700 dark:text-green-400 underline" href="${getRelativeLocaleUrl(locale, "/blog/mobile-android-online")}">онлайн или мобильный</a>. DLC The Miner Was Replaced выйдет 2 ноября 2026 года.`,
                        })} />
                </p>
                <div
                    class="flex flex-wrap gap-4 justify-center md:justify-start pt-6"
                >
                    <a
                        href={getRelativeLocaleUrl(locale, "/tutorial")}
                        class="px-8 py-4 bg-green-600 hover:bg-green-700 text-white rounded-xl font-bold shadow-lg shadow-green-200 dark:shadow-none transition transform hover:-translate-y-1"
                    >
                        {
                            t({
                                zh: "看攻略，先复制脚本",
                                en: "Read the guide",
                                de: "Guide lesen",
                                ru: "Читать гайд",
                            })
                        }
                    </a>
                    <a
                        href="#scripts"
                        class="px-8 py-4 bg-white hover:bg-gray-50 text-gray-900 border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 rounded-xl font-bold transition"
                    >
                        {
                            t({
                                zh: "浏览脚本库",
                                en: "Browse Scripts",
                                de: "Skripte durchsuchen",
                                ru: "Смотреть скрипты",
                            })
                        }
                    </a>
                </div>
                <AdNative />
                <div class="flex justify-center md:justify-start w-full">
                    <CollapsibleText />
                </div>
            </div>

            <div class="flex-1 w-full max-w-xl">
                <div
                    class="relative rounded-2xl overflow-hidden shadow-2xl ring-1 ring-gray-900/5 dark:ring-white/10"
                >
                    <Image
                        src={logo}
                        alt="Logo"
                        width={600}
                        height={600}
                        class="rounded-xl"
                    />
                </div>
            </div>
        </div>
    </section>


<section class="px-4 pt-10">
    <div class="max-w-6xl mx-auto rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <p class="text-sm font-bold uppercase tracking-wide text-amber-700 dark:text-amber-300 mb-1">
                {t({ en: "News · Sep 2026", zh: "新闻 · 2026年9月", de: "News · Sep 2026",
ru: "Новости · Сен 2026" })}
            </p>
            <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 dark:text-white mb-2">
                {t({
                    en: "DLC The Miner Was Replaced — November 2, 2026",
                    zh: "DLC《The Miner Was Replaced》— 2026年11月2日",
                    de: "DLC The Miner Was Replaced — 2. November 2026",
                    ru: "DLC The Miner Was Replaced — 2 ноября 2026 года",
                })}
            </h2>
            <p class="text-gray-700 dark:text-gray-300 max-w-3xl">
                {t({
                    en: "Official Steam announcement: leave the farm for underground mining — coal, quartz, mushrooms, dynamite, rice on clay, and a Minesweeper-style puzzle in a new unlock tree. Wishlist on Steam; playtest signup is on the base-game / DLC pages.",
                    zh: "Steam 官宣：离开农场进入地下采矿——煤、石英、蘑菇、炸药、黏土种稻，以及扫雷式谜题和新解锁树。可在 Steam 加入愿望单；试玩报名见本体 / DLC 页面。",
                    de: "Steam-Ankündigung: Untertage-Bergbau mit neuen Ressourcen und Programmier-Herausforderungen. Auf Steam wishlisten; Playtest über die Steam-Seiten.",
                    ru: "Официальное объявление Steam: покиньте ферму для подземной добычи угля, кварца, грибов, динамита, риса на глине и головоломки в стиле тральщика в новом дереве разблокировки. Список желаний в Steam; регистрация в playtest на страницах базовой игры / DLC.",
                })}
            </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
            <a
                href="https://store.steampowered.com/app/4521700/The_Miner_Was_Replaced/"
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-3 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold shadow-sm"
            >
                {t({ en: "Steam DLC", zh: "Steam DLC", de: "Steam-DLC",
ru: "Steam DLC" })}
            </a>
        </div>
    </div>
</section>

