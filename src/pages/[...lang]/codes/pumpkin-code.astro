---
import { DEFAULT_LOCALE_SETTING, LOCALES_SETTING } from "@/locales";
import { useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import AdNative from "@/components/AdNative.astro";
import RelatedGuides from "@/components/RelatedGuides.astro";

const t = useTranslations(Astro.currentLocale as Lang);
const locale = Astro.currentLocale || DEFAULT_LOCALE_SETTING;

export const getStaticPaths = async () => {
	const paths = Object.keys(LOCALES_SETTING).map((lang) => {
		if (lang !== DEFAULT_LOCALE_SETTING) {
			return { params: { lang: lang } };
		}
		return { params: { lang: undefined } };
	});
	return paths;
};

const title = {
	en: "Pumpkin Code — Giant Pumpkin, measure() Size Check, Don't Harvest Early",
	zh: "南瓜代码 — 巨大南瓜、measure() 尺寸检查，别提前收",
	de: "Kürbis-Code — Riesenkürbis, measure()-Größenprüfung, nicht zu früh ernten",
};

const description = {
	en: "The Farmer Was Replaced pumpkin code for 1.0+: patch dead tiles, use measure() to check pumpkin size on opposite corners, harvest only when the full grid merged (n³ then 6n²).",
	zh: "编程农场 1.0+ 南瓜代码：补枯死格，用 measure() 对角检查南瓜尺寸，整田合并后再收（n³，后 6n²）。",
	de: "Kürbis-Code 1.0+: tote Felder flicken, measure() an gegenüberliegenden Ecken prüfen, erst ernten wenn das Raster fusioniert (n³, dann 6n²).",
};
---

<Layout title={title} description={description}>
	<div class="max-w-4xl mx-auto px-4">
		<section class="py-10 text-center border-b border-gray-200 dark:border-gray-700">
			<h1 class="text-3xl md:text-4xl font-extrabold mb-6 text-gray-900 dark:text-white">
				{t({
					en: "The Farmer Was Replaced Pumpkin Code — Patch Dead Tiles, Then Harvest",
					zh: "编程农场南瓜代码 — 先补枯死格，再收巨大南瓜",
					de: "The Farmer Was Replaced Kürbis-Code — tote Felder flicken, dann ernten",
				})}
			</h1>
			<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
				{t({
					en: "Written for the current 1.0+ build (multi-drone era). Pumpkins merge into one giant crop. A simple harvest loop collapses the merge. Track dead tiles, replant, and harvest only when every tile is a live pumpkin.",
					zh: "按当前 1.0+（多无人机）机制重写。南瓜会合并成巨大作物；普通收割循环会拆掉合并。记下枯死格、补种，整田都是活南瓜再收。",
					de: "Für den aktuellen 1.0+-Stand. Kürbisse fusionieren. Einfache Ernte-Schleifen zerstören die Fusion. Tote Felder tracken, nachpflanzen, erst ernten wenn alles lebendig ist.",
				})}
			</p>
		</section>

		<AdNative />

		<section class="py-8 prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">
			<h2 class="text-2xl font-bold text-orange-700 dark:text-orange-400">
				{t({ en: "1.0 pumpkin rules (what changed vs old tips)", zh: "1.0 南瓜规则（和旧攻略差在哪）", de: "1.0-Kürbis-Regeln" })}
			</h2>
			<ul>
				<li>{t({ en: "Plant on soil: `till()` until `Grounds.Soil`. Planting spends carrots (check `get_cost(Entities.Pumpkin)`).", zh: "种在土上：`till()` 到 `Grounds.Soil`。种植消耗胡萝卜（用 `get_cost(Entities.Pumpkin)` 看花费）。", de: "Auf Soil pflanzen. Kosten mit `get_cost(Entities.Pumpkin)` prüfen." })}</li>
				<li>{t({ en: "About 1 in 5 pumpkins die at ripeness and leave `Entities.Dead_Pumpkin`. `can_harvest()` is always False on a dead tile. Dead tiles block the giant merge.", zh: "约五分之一成熟时枯死，留下 `Entities.Dead_Pumpkin`。枯死格上 `can_harvest()` 永远是 False，并挡住巨大合并。", de: "Etwa jeder fünfte stirbt als Dead_Pumpkin und blockiert die Fusion." })}</li>
				<li>{t({ en: "Fully grown adjacent pumpkins merge. Yield is **n³** for side length 1–5, then **6·n²** from 6×6 up (32×32 → 6,144). Harvest early and you only get small clusters.", zh: "相邻成熟南瓜会合并。边长 1–5 产量是 **n³**，从 6×6 起是 **6·n²**（32×32 → 6144）。提前收只剩小块。", de: "Ertrag: n³ für 1–5, ab 6×6: 6·n² (32×32 → 6144)." })}</li>
				<li>{t({ en: "Water speeds growth (up to 5× at water level 1) but does **not** stop deaths. Planting anything on a dead pumpkin clears it (wiki). Optionally fertilize the **new** plant after replanting to cut 2s grow time.", zh: "浇水加速生长（水位 1 时最高约 5×），但**挡不住**枯死。在枯死格上种任何东西都会清掉它（wiki）。补种后可对**新苗**施肥，缩短约 2 秒生长。", de: "Wasser beschleunigt, verhindert aber keine Tode. Darüber pflanzen entfernt Dead Pumpkin (Wiki). Optional die neue Pflanze düngen (−2s)." })}</li>
			</ul>
		</section>

		<section class="py-10 grid md:grid-cols-2 gap-8 items-center">
			<div class="order-2 md:order-1">
				<h2 class="text-2xl font-bold mb-4 text-orange-600 dark:text-orange-400">
					{t({ en: "Strategy: plant → track bad tiles → patch → harvest", zh: "策略：种满 → 记坏格 → 只补坏格 → 再收", de: "Strategie: pflanzen → Bad-Tiles → flicken → ernten" })}
				</h2>
				<div class="prose dark:prose-invert text-gray-700 dark:text-gray-300 space-y-4">
					<p>
						{t({
							en: "Do not re-scan the whole farm forever. After the first pass, keep a list of coordinates that are empty, dead, or not yet harvestable. Only fly back to those tiles.",
							zh: "不要永远全图扫描。第一遍之后，只保留空格、枯死、未成熟的坐标列表，无人机只飞回这些格子。",
							de: "Nicht ewig das ganze Feld scannen. Nach dem ersten Pass nur leere/tote/unreife Koordinaten anfliegen.",
						})}
					</p>
					<ul class="list-disc pl-5 space-y-2">
						<li><strong>{t({ en: "Plant:", zh: "种：", de: "Pflanzen:" })}</strong> {t({ en: "Till + plant every tile once.", zh: "每格翻土并种一次。", de: "Einmal pflügen und pflanzen." })}</li>
						<li><strong>{t({ en: "Track:", zh: "记：", de: "Tracken:" })}</strong> {t({ en: "Append `[x, y]` when `not can_harvest()` or entity is Dead_Pumpkin.", zh: "`not can_harvest()` 或实体是 Dead_Pumpkin 时记下 `[x, y]`。", de: "`[x, y]` merken wenn nicht erntebereit." })}</li>
						<li><strong>{t({ en: "Patch:", zh: "补：", de: "Flicken:" })}</strong> {t({ en: "Replant over dead/empty; optionally `use_item(Items.Fertilizer)` on the new plant.", zh: "在枯死/空格上补种；可对新苗 `use_item(Items.Fertilizer)`。", de: "Darüber pflanzen; optional neue Pflanze düngen." })}</li>
						<li><strong>{t({ en: "Harvest:", zh: "收：", de: "Ernten:" })}</strong> {t({ en: "When the bad list is empty, `harvest()` once anywhere on the giant pumpkin.", zh: "坏格列表空了，在巨大南瓜任意一格 `harvest()` 一次即可。", de: "Liste leer → einmal harvest()." })}</li>
					</ul>
				</div>
			</div>
			<div class="order-1 md:order-2">
				<div class="bg-orange-50 dark:bg-orange-900/20 p-2 rounded-2xl shadow-lg border border-orange-100 dark:border-orange-800">
					<div class="aspect-video flex items-center justify-center text-6xl">🎃</div>
				</div>
			</div>
		</section>

		<section class="py-6">
			<h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
				{t({ en: "Teaching script (single drone)", zh: "教学脚本（单无人机）", de: "Lehrskript (eine Drohne)" })}
			</h2>
			<p class="mb-4 text-gray-600 dark:text-gray-400">
				{t({
					en: "Uses only documented APIs. No invented helpers. After Megafarm, split the farm into column/sector loops — see the multi-drone note below.",
					zh: "只用文档里的 API。解锁 Megafarm 后按列/扇区拆分——见下方多无人机说明。",
					de: "Nur dokumentierte APIs. Nach Megafarm Spalten/Sektoren teilen.",
				})}
			</p>
			<CodeBlock
				height="max-h-[800px]"
				code={`def go_to(x, y):
	while get_pos_x() != x:
		if get_pos_x() < x:
			move(East)
		else:
			move(West)
	while get_pos_y() != y:
		if get_pos_y() < y:
			move(North)
		else:
			move(South)

def plant_full_field():
	size = get_world_size()
	for y in range(size):
		for x in range(size):
			go_to(x, y)
			if get_ground_type() != Grounds.Soil:
				till()
			# Planting over Dead_Pumpkin removes it (wiki). No harvest needed.
			plant(Entities.Pumpkin)
			if get_water() < 0.75:
				use_item(Items.Water)

def collect_bad_tiles():
	bad = []
	size = get_world_size()
	for y in range(size):
		for x in range(size):
			go_to(x, y)
			ent = get_entity_type()
			if ent == Entities.Dead_Pumpkin or ent != Entities.Pumpkin or not can_harvest():
				bad.append([x, y])
	return bad

def patch_bad(bad):
	# Only revisit problem tiles until the list is empty
	while len(bad) > 0:
		still_bad = []
		for pos in bad:
			x = pos[0]
			y = pos[1]
			go_to(x, y)
			ent = get_entity_type()
			if ent != Entities.Pumpkin:
				# Dead_Pumpkin or empty: planting clears dead (wiki)
				if get_ground_type() != Grounds.Soil:
					till()
				plant(Entities.Pumpkin)
				still_bad.append([x, y])
			elif not can_harvest():
				# Live but still growing — wait
				still_bad.append([x, y])
			# else: live + harvestable — drop from list
		bad = still_bad

clear()
while True:
	plant_full_field()
	bad = collect_bad_tiles()
	patch_bad(bad)
	# Full grid is live pumpkins → giant merge should be ready
	go_to(0, 0)
	harvest()`}
			/>
		</section>


		<section class="py-8 prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">
			<h2 class="text-2xl font-bold text-orange-700 dark:text-orange-400">
				{t({
					en: "How to check pumpkin size with measure() (pumpkin measure)",
					zh: "用 measure() 检查南瓜尺寸（pumpkin measure）",
					de: "Kürbisgröße mit measure() prüfen (pumpkin measure)",
				})}
			</h2>
			<ul>
				<li>{t({
					en: "On pumpkins, `measure()` returns a stable ID for that merged pumpkin (same value on every tile of the same giant pumpkin).",
					zh: "在南瓜上，`measure()` 返回该合并南瓜的稳定 ID（同一巨大南瓜的每格数值相同）。",
					de: "Auf Kürbissen liefert `measure()` eine stabile ID derselben Fusion (gleicher Wert auf jedem Feld).",
				})}</li>
				<li>{t({
					en: "To check if the **whole square field** has merged: measure one corner, measure the opposite corner; if the values match, harvest.",
					zh: "检查**整块方形田**是否已合并：量一个角，再量对角；数值相同就可以收。",
					de: "Ganze Quadratfläche fusioniert? Eine Ecke und die gegenüberliegende messen — gleiche Werte → ernten.",
				})}</li>
				<li>{t({
					en: "Works reliably on **square** monocrop pumpkin fields. Rectangular mixed fields can merge in odd shapes — then keep using the bad-tile list.",
					zh: "在**方形**纯南瓜田上很稳。矩形或混种田可能奇形合并——那时继续用坏格列表。",
					de: "Zuverlässig auf **quadratischen** Monokultur-Feldern. Rechteck/Mix → weiter Bad-Tile-Liste nutzen.",
				})}</li>
				<li>{t({
					en: "This answers searches for **pumpkin measure** and **how to check pumpkin size** without inventing a separate page.",
					zh: "这样就能覆盖 **pumpkin measure** 和 **how to check pumpkin size** 的搜索，不必另开一页。",
					de: "Deckt Suchen nach **pumpkin measure** und **how to check pumpkin size** ab.",
				})}</li>
			</ul>
			<p class="mb-4">
				{t({
					en: "Example helper you can call after `patch_bad(...)`:",
					zh: "在 `patch_bad(...)` 之后可调用的示例：",
					de: "Beispiel-Hilfe nach `patch_bad(...)`:",
				})}
			</p>
			<CodeBlock
				height="max-h-[420px]"
				code={`def pumpkin_fully_merged():
	size = get_world_size()
	go_to(0, 0)
	if get_entity_type() != Entities.Pumpkin or not can_harvest():
		return False
	a = measure()
	go_to(size - 1, size - 1)
	if get_entity_type() != Entities.Pumpkin or not can_harvest():
		return False
	return measure() == a

# After patch_bad(...):
go_to(0, 0)
if pumpkin_fully_merged():
	harvest()`}
			/>
			<p class="mt-4">
				{t({
					en: "Scaling further with a drone fleet? See the ",
					zh: "要用多无人机继续扩规模？看 ",
					de: "Weiter skalieren mit Drohnenflotte? Siehe ",
				})}
				<a class="text-orange-700 dark:text-orange-400 underline" href={getRelativeLocaleUrl(locale, "/blog/multiple-drones")}>
					{t({ en: "multiple drones", zh: "多无人机", de: "multiple drones" })}
				</a>
				{t({ en: " guide.", zh: " 指南。", de: "-Guide." })}
			</p>
		</section>

		<section class="py-8 bg-orange-50 dark:bg-orange-900/20 rounded-2xl border border-orange-100 dark:border-orange-800 p-6 mb-8">
			<h3 class="text-xl font-bold mb-3 text-orange-800 dark:text-orange-300">
				{t({ en: "Multi-drone (Megafarm) — Sep–Oct 2026 consensus", zh: "多无人机（Megafarm）— 2026年9–10月共识", de: "Multi-Drohne — Konsens Sep–Okt 2026" })}
			</h3>
			<ul class="space-y-2 text-orange-900 dark:text-orange-100 list-disc pl-5">
				<li>{t({ en: "Drones do **not** share globals. Give each drone its own column range or rectangle; do not append to one shared bad-tile list from every drone.", zh: "无人机**不共享**全局变量。每架机分一段列或矩形；不要让所有机往同一个坏格列表里 append。", de: "Keine gemeinsamen Globals. Jede Drohne eigener Sektor." })}</li>
				<li>{t({ en: "`spawn_drone(fn)` then `wait_for(handle)` to sync phases (plant → patch → harvest). Pattern: `if not spawn_drone(task): task()`.", zh: "`spawn_drone(fn)` 后用 `wait_for(handle)` 同步阶段（种→补→收）。常用：`if not spawn_drone(task): task()`。", de: "`spawn_drone` + `wait_for`. Muster: `if not spawn_drone(task): task()`." })}</li>
				<li>{t({ en: "Leaderboard farms water every tile and keep the bad-tile loop tight — community posts report multi-million pumpkin/min with parallel sectors.", zh: "冲榜会每格浇水并收紧坏格循环——社区有多扇区并行冲到数百万南瓜/分钟的记录。", de: "Bestzeiten gießen jedes Feld und halten die Bad-Tile-Schleife eng." })}</li>
				<li>
					{t({ en: "Full Megafarm patterns: ", zh: "完整 Megafarm 写法：", de: "Volle Megafarm-Muster: " })}
					<a class="underline" href={getRelativeLocaleUrl(locale, "/blog/multiple-drones")}>
						{t({ en: "multiple drones guide", zh: "多无人机指南", de: "Multiple-Drones-Guide" })}
					</a>
				</li>
			</ul>
		</section>

		<RelatedGuides current="/codes/pumpkin-code" />
		<div class="text-center py-6">
			<a href={getRelativeLocaleUrl(locale, "/")} class="text-blue-500 hover:text-blue-700 underline">
				{t({ en: "← Back to Home", zh: "← 返回主页", de: "← Zurück zur Startseite" })}
			</a>
		</div>
		<div id="utterances-container" class="my-10"></div>
	</div>
</Layout>
