---
import { DEFAULT_LOCALE_SETTING, LOCALES_SETTING } from "@/locales";
import { useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import AdNative from "@/components/AdNative.astro";
import RelatedGuides from "@/components/RelatedGuides.astro";

const t = useTranslations(Astro.currentLocale as Lang);
const locale = Astro.currentLocale || DEFAULT_LOCALE_SETTING;

export const getStaticPaths = async () => {
	const paths = Object.keys(LOCALES_SETTING).map((lang) => {
		if (lang !== DEFAULT_LOCALE_SETTING) {
			return { params: { lang: lang } };
		}
		return { params: { lang: undefined } };
	});
	return paths;
};

const title = {
	en: "Sunflower Code — Harvest Max Petals Only",
	zh: "向日葵代码 — 只收瓣数最多的那朵",
	de: "Sonnenblumen-Code — Nur die Blume mit den meisten Blütenblättern",
};

const description = {
	en: "The Farmer Was Replaced sunflower code for 1.0+: measure petals 7–15, keep 10+ flowers for the 8× Power bonus, harvest only the current max. Multi-drone sync tips included.",
	zh: "编程农场 1.0+ 向日葵：瓣数 7–15，保持 ≥10 朵才有 8× Power，只收当前最高瓣。含多无人机同步思路。",
	de: "Sonnenblumen-Code 1.0+: Blüten 7–15, ≥10 Blumen für 8× Power, nur das Maximum ernten. Multi-Drohne inkl.",
};
---

<Layout title={title} description={description}>
	<div class="max-w-4xl mx-auto px-4">
		<section class="py-10 text-center border-b border-gray-200 dark:border-gray-700">
			<h1 class="text-3xl md:text-4xl font-extrabold mb-6 text-gray-900 dark:text-white">
				{t({
					en: "The Farmer Was Replaced Sunflower Code — Max Petals, Then Power",
					zh: "编程农场向日葵代码 — 先找最高瓣，再刷 Power",
					de: "The Farmer Was Replaced Sonnenblumen-Code — Maximum, dann Power",
				})}
			</h1>
			<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
				{t({
					en: "Rewritten for 1.0+. Sunflowers pay Power. The 8× bonus only fires when you harvest the current max-petal flower while at least 10 sunflowers are on the farm. Harvest a smaller one and you lose the bonus for that harvest and the next.",
					zh: "按 1.0+ 重写。向日葵产 Power。只有田间至少 10 朵、且你收的是当前瓣数最高的那朵，才有 8× 奖励。收错一朵，这一次和下一次都会丢奖励。",
					de: "Neu für 1.0+. 8×-Bonus nur bei aktuellem Maximum und ≥10 Sonnenblumen. Falsche Ernte kostet diesen und den nächsten Bonus.",
				})}
			</p>
		</section>

		<AdNative />

		<section class="py-10 prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">
			<h2 class="text-2xl font-bold text-yellow-700 dark:text-yellow-400">
				{t({ en: "How sunflowers work in 1.0+", zh: "1.0+ 向日葵规则", de: "Sonnenblumen in 1.0+" })}
			</h2>
			<ul>
				<li>{t({ en: "Plant on soil (`till()` → `Grounds.Soil`). Planting costs carrots.", zh: "种在耕过的土上。种植消耗胡萝卜。", de: "Auf Soil pflanzen. Kostet Karotten." })}</li>
				<li>{t({ en: "`measure()` returns petal count **7–15** (works even before fully grown).", zh: "`measure()` 返回瓣数 **7–15**（未完全成熟也能量）。", de: "`measure()` liefert 7–15 Blütenblätter." })}</li>
				<li>{t({ en: "Harvest the largest petal count while **≥10** sunflowers exist → **8×** Power. Wrong flower → no bonus this time **and** next harvest.", zh: "田间 **≥10** 朵时收最高瓣 → **8×** Power。收错 → 这次**和**下次都没加成。", de: "Bei ≥10 Blumen das Maximum → 8×. Falsch → Bonus diesmal und nächstes Mal weg." })}</li>
				<li>{t({ en: "Do **not** harvest every ready flower in a simple loop — that is the most common copy-paste mistake.", zh: "**不要**用普通循环把成熟花一收而光——这是最常见的复制粘贴错误。", de: "Nicht jede reife Blume in einer Schleife ernten." })}</li>
			</ul>
		</section>

		<section class="py-6">
			<h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
				{t({ en: "Single-drone: plant, then harvest current max", zh: "单机：种满，再只收当前最高瓣", de: "Eine Drohne: pflanzen, dann aktuelles Maximum" })}
			</h2>
			<CodeBlock
				height="max-h-[700px]"
				code={`def go_to(x, y):
	while get_pos_x() != x:
		if get_pos_x() < x:
			move(East)
		else:
			move(West)
	while get_pos_y() != y:
		if get_pos_y() < y:
			move(North)
		else:
			move(South)

def plant_field():
	size = get_world_size()
	for y in range(size):
		for x in range(size):
			go_to(x, y)
			if get_ground_type() != Grounds.Soil:
				till()
			if can_harvest():
				harvest()
			if get_entity_type() != Entities.Sunflower:
				plant(Entities.Sunflower)
			if get_water() < 0.75:
				use_item(Items.Water)

def harvest_current_max():
	size = get_world_size()
	best = 0
	bx = -1
	by = -1
	found = False
	for y in range(size):
		for x in range(size):
			go_to(x, y)
			if get_entity_type() == Entities.Sunflower and can_harvest():
				petals = measure()
				if (not found) or petals > best:
					best = petals
					bx = x
					by = y
					found = True
	if not found:
		return False
	go_to(bx, by)
	harvest()
	return True

clear()
while True:
	plant_field()
	# Keep harvesting the current max until the field is empty
	while harvest_current_max():
		pass`}
			/>
		</section>

		<section class="py-8 bg-yellow-50 dark:bg-yellow-900/20 rounded-2xl border border-yellow-100 dark:border-yellow-800 p-6 mb-8">
			<h3 class="text-xl font-bold mb-3 text-yellow-800 dark:text-yellow-300">
				{t({ en: "Multi-drone patterns (Reddit Sep 2026)", zh: "多无人机做法（Reddit 2026-09）", de: "Multi-Drohne (Reddit Sep 2026)" })}
			</h3>
			<ul class="space-y-3 text-yellow-900 dark:text-yellow-100 list-disc pl-5">
				<li>{t({ en: "**No shared memory.** Spawned drones do not share globals. Collect petal maps by returning a list from each drone and reading it with `wait_for(handle)`.", zh: "**无共享内存。** 子无人机不共享全局。每架机返回瓣数列表，主无人机用 `wait_for(handle)` 收集。", de: "Kein Shared Memory. Rückgaben per `wait_for` sammeln." })}</li>
				<li>{t({ en: "**Petal-tier sync:** spawn one drone per column; harvest only 15s, `wait_for` all, then 14s, then 13s… until the field is empty.", zh: "**按瓣数分层同步：** 每列一架机；只收 15 瓣 → `wait_for` 全部完成 → 再收 14 → 13… 直到清空。", de: "Blüten-Stufen: erst 15er, wait_for, dann 14er…" })}</li>
				<li>{t({ en: "**Max-15 cheese:** plant, `measure()`, if petals are under 15, harvest+replant until every tile is 15, then harvest the whole field as maxes. Fast for Power, skips sorting.", zh: "**全 15 瓣套路：** 种下后 `measure()`，不足 15 就收掉重种，直到整田都是 15，再当最高瓣收。刷 Power 快，跳过排序。", de: "Max-15-Trick: nachpflanzen bis alles 15 ist." })}</li>
			</ul>
		</section>

		<RelatedGuides current="/codes/sunflower-code" />
		<div class="text-center py-6">
			<a href={getRelativeLocaleUrl(locale, "/")} class="text-blue-500 hover:text-blue-700 underline">
				{t({ en: "← Back to Home", zh: "← 返回主页", de: "← Zurück zur Startseite" })}
			</a>
		</div>
		<div id="utterances-container" class="my-10"></div>
	</div>
</Layout>
