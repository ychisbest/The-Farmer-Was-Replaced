---
// Adsterra Native Banner for thefarmerwasreplaced.com (domain 5988510, placement 30784034).
// Uses Anti-Adblock endpoint and strict single-slot mounting so #container-b1cc5426fa303af1c313c4d3ee76938f
// stays anchored to the first visible slot on the page (never stripped or duplicated by footer fallback).
---

<aside
	class="ad-native my-8 w-full max-w-4xl mx-auto min-h-[90px] flex justify-center overflow-hidden relative z-[1]"
	data-ad-native
	aria-label="Advertisement"
>
	<div class="ad-native-box w-full"></div>
</aside>
<script is:inline data-cfasync="false">
	(function () {
		var CONTAINER_ID = "container-b1cc5426fa303af1c313c4d3ee76938f";
		var SCRIPT_SRC =
			"https://bauval.org/21/b1cc5426fa303af1c313c4d3ee76938f";
		var root =
			document.currentScript &&
			document.currentScript.previousElementSibling;
		if (!root || !root.hasAttribute("data-ad-native")) return;

		if (window.__farmerAdNativeMounted || document.getElementById(CONTAINER_ID)) {
			root.hidden = true;
			root.style.display = "none";
			return;
		}

		var box = root.querySelector(".ad-native-box");
		if (!box) return;

		window.__farmerAdNativeMounted = true;
		box.id = CONTAINER_ID;

		var s = document.createElement("script");
		s.async = true;
		s.setAttribute("data-cfasync", "false");
		s.src = SCRIPT_SRC;
		root.insertBefore(s, box);
	})();
</script>
